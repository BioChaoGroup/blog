# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown: trailing two spaces are a hard line break, so leave them alone.
[*.md]
trim_trailing_whitespace = false

[*.mdx]
trim_trailing_whitespace = false

# YAML in workflows and content frontmatter is always two spaces.
[*.{yml,yaml}]
indent_size = 2

# Generated data: formatting is owned by scripts/sync-github.mjs, not the editor.
[src/data/github.json]
insert_final_newline = true
