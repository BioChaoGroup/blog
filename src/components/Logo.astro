---
import { withBase } from '@/lib/url';

interface Props {
  id: string;
  /** Pass an empty label when the parent link already supplies its name. */
  label?: string;
}
const { id, label = 'BioChaoGroup · AI × BI × SCI' } = Astro.props;
const maskId = `fungal-logo-${id}`;
---
{/* The approved artwork's alpha mask preserves its shape and lettering;
    site tokens provide exact brand colours in both themes. */}
<svg
  class="brand__logo"
  viewBox="72 112 2040 510"
  width="264"
  height="66"
  xmlns="http://www.w3.org/2000/svg"
  role={label ? 'img' : 'presentation'}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
>
  <defs>
    <mask id={maskId} x="0" y="0" width="2172" height="724" maskUnits="userSpaceOnUse" style="mask-type: alpha">
      <image href={withBase('/brand/fungal-lockup-source.png')} width="2172" height="724" />
    </mask>
  </defs>
  <g mask={`url(#${maskId})`}>
    <path fill="var(--ink)" d="M0 0h2172v724H0z" />
    <path fill="var(--brand)" d="M0 0h680v724H0z" />
    <path fill="var(--accent)" d="M680 450h1492v274H680z" />
  </g>
</svg>
