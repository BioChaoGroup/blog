---
interface Props {
  eyebrow?: string;
  title: string;
  linkHref?: string;
  linkLabel?: string;
  id?: string;
}
const { eyebrow, title, linkHref, linkLabel, id } = Astro.props;
---
<div class="section-head">
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class="section-head__title" id={id}>{title}</h2>
  </div>
  {
    linkHref && linkLabel && (
      <a class="section-head__link" href={linkHref}>
        {linkLabel}
      </a>
    )
  }
</div>
